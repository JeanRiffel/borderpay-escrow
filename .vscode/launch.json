{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Hardhat tests",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/hardhat/dist/src/cli.js",
      "args": ["test"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug current test file",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/hardhat/dist/src/cli.js",
      "args": ["test", "${file}"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
